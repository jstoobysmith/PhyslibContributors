{
  // The shared library (src/lib), the scripts and the tests: no browser APIs.
  // If src/lib uses something browser-only, this check fails.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "jsx": "preserve",
    "types": ["node"]
  },
  "include": ["src/lib", "scripts", "test", "vite.config.ts", "vitest.config.ts"]
}
